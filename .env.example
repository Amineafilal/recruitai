# =============================================================================
# RecruitAI — variables d'environnement
#
# Développement : copier ce fichier en `.env` à la racine du monorepo.
# Production    : saisir ces variables dans Railway (API) et Vercel (site).
#                 Ne jamais committer de valeurs réelles — `.env` est ignoré.
#
# Les variables marquées [API] ne servent qu'à Railway, [WEB] qu'à Vercel.
# =============================================================================

# --- Base de données Supabase --------------------------------------- [API] --
# Projet DÉDIÉ à RecruitAI, région EU (données candidats stockées en Europe).
#
# NB : ne pas ajouter "?pgbouncer=true". C'est un paramètre propre à Prisma ;
# postgres-js le transmettrait au serveur comme option inconnue. Le mode
# transaction est géré côté code par prepare: false (packages/db/src/client.ts).

# Runtime : pooler en mode transaction, port 6543. Rôle recruitai_app SANS
# BYPASSRLS — c'est lui qui rend l'isolation entre agences réellement
# effective. Créé par packages/db/sql/0002_supabase_roles.sql.
DATABASE_URL=postgresql://recruitai_app.<ref>:<motdepasse>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Migrations et DDL : port 5432, rôle postgres. Le mode transaction ne
# supporte ni le DDL ni les advisory locks de drizzle-kit.
DIRECT_URL=postgresql://postgres.<ref>:<motdepasse>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Tâches inter-agences (crons) : rôle recruitai_admin AVEC BYPASSRLS. Distinct
# du rôle applicatif pour que l'isolation reste effective partout ailleurs.
# Optionnel : DIRECT_URL est utilisé en repli.
ADMIN_DATABASE_URL=

# --- Authentification ------------------------------------------------ [API] --
# Signature des sessions. Minimum 32 caractères, aléatoire. Le changer
# déconnecte tous les utilisateurs.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=

# --- URLs publiques --------------------------------------------------------
# [API] Racine du site, utilisée dans les liens des emails (invitation, mot de
# passe oublié, désinscription). Sans elle, ces liens pointent vers localhost.
PUBLIC_APP_URL=https://recruitai.vercel.app

# [API] Origines autorisées à appeler l'API depuis un navigateur, séparées par
# des virgules. En production, sans cette variable les appels navigateur sont
# refusés (le formulaire de contact cesserait de fonctionner).
CORS_ORIGINS=https://recruitai.vercel.app

# [WEB] Adresse de l'API.
# ATTENTION : injectée à la COMPILATION. La modifier exige de relancer un
# build Vercel — un simple redémarrage ne suffit pas.
NEXT_PUBLIC_API_URL=https://recruitai-api.up.railway.app

# --- Envoi d'emails (Resend) ----------------------------------------- [API] --
RESEND_API_KEY=
# Tant qu'aucun domaine n'est vérifié chez Resend, SEUL l'email propriétaire du
# compte reçoit quoi que ce soit : relances candidats, invitations d'équipe et
# réinitialisation de mot de passe sont donc inopérantes en production.
# Vérifier un domaine sur resend.com/domains puis remplacer l'expéditeur.
OUTREACH_FROM_EMAIL=RecruitAI <onboarding@resend.dev>
# Destinataire du formulaire de contact de la page d'accueil.
CONTACT_TO_EMAIL=

# --- Scraping (Apify) ------------------------------------------------ [API] --
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR_ID=harvestapi~linkedin-profile-search
# Mode de scraping. Trois valeurs acceptées, du moins au plus cher :
#
#   Short                  0,10 $ / recherche (jusqu'a 25 profils courts)
#                          nom, titre, URL, localisation. Suffisant pour noter,
#                          mais AUCUNE coordonnee et pas d'experience detaillee.
#
#   Full                   0,10 $ + 0,004 $ / profil
#                          ajoute l'experience complete, la formation, les
#                          competences. Necessaire pour que la fiche candidat
#                          soit reellement exploitable par un recruteur.
#
#   "Full + email search"  0,10 $ + 0,01 $ / profil
#                          tente en plus de retrouver l'email professionnel,
#                          valide par SMTP. L'email n'est PAS lu sur LinkedIn
#                          (il n'y est pas public) : c'est une recherche
#                          independante, sans garantie de resultat. Non facture
#                          si le profil est trop incomplet pour la tenter.
#
# Cout pour 15 candidats : 0,10 $ / 0,16 $ / 0,25 $ selon le mode.
#
# ATTENTION RGPD : retrouver l'email d'une personne sans son consentement
# declenche l'obligation d'information de l'article 14. A n'activer qu'en
# connaissance de cause.
APIFY_LINKEDIN_MODE=Short
APIFY_MAX_PROFILES_PER_SEARCH=15
# Profils CVthèque relus par nuit et par agence — chacun consomme un crédit réel.
ENRICH_BATCH_SIZE=100
# Plafond mensuel de crédits, toutes agences confondues. Prend le pas sur le
# plafond du plan s'il est plus bas : garde-fou tant que le coût réel par
# client n'a pas été mesuré sur un mois complet.
SCRAPE_CREDITS_CAP=500

# Sources non encore câblées. Renseigner un identifiant d'actor active la
# source dans le sourcing quotidien — ne pas remplir tant que le mapping
# d'entrée n'est pas écrit dans buildActorInput.
APIFY_INDEED_ACTOR_ID=
APIFY_APEC_ACTOR_ID=
APIFY_WTTJ_ACTOR_ID=

# --- Notation des candidats ------------------------------------------ [API] --
MISTRAL_API_KEY=
# Optionnel : utilisé uniquement en repli si Mistral échoue.
OPENAI_API_KEY=

# --- Tâches automatiques --------------------------------------------- [API] --
# "false" désactive tous les crons. Indispensable si un environnement de test
# partage la base d'un environnement réel : sans ça, les deux enverraient les
# relances en double.
SCHEDULER_ENABLED=true
# Conservation des profils CVthèque sans activité, en mois (recommandation
# CNIL : 24).
RGPD_RETENTION_MOIS=24

# --- Développement local uniquement ------------------------------------------
# Ignoré en production : l'hébergeur impose son propre port via PORT.
API_PORT=3001
